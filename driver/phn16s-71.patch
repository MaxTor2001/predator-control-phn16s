 static int
 acer_predator_v4_platform_profile_probe(void *drvdata, unsigned long *choices)
 {
+	u8 tp;
+
+	/* PHN16S-71 firmware reports 0x02 until a profile is selected for the first time */
+	if (!WMID_gaming_get_misc_setting(ACER_WMID_MISC_SETTING_PLATFORM_PROFILE, &tp) &&
+	    tp == ACER_PREDATOR_V4_THERMAL_PROFILE_UNSET)
+		WMID_gaming_set_misc_setting(ACER_WMID_MISC_SETTING_PLATFORM_PROFILE,
+					     ACER_PREDATOR_V4_THERMAL_PROFILE_BALANCED);
+
